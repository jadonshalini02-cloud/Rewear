# Database Configuration (PostgreSQL / SQLite / Persistent Database URL)
DATABASE_URL="postgresql://user:password@ep-example.neon.tech/rewear?sslmode=require"
# Neon/Vercel integrations may provide POSTGRES_URL or STORAGE_URL instead; the app accepts these names too.

# JWT Secret for Auth tokens
JWT_SECRET="rewear_jwt_secure_secret_key_2026_dev_prod"

# Server Port
PORT=3000

# Cloudinary / Image Storage (Optional in dev, mock/local fallback supported)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Client URL (for CORS in production)
CLIENT_URL="http://localhost:3000"

# Public API URL (defaults to relative /api when hosted together)
VITE_API_URL="/api"

# AI Studio injected variables
GEMINI_API_KEY=""
APP_URL=""

# Vercel production deployment:
# Set DATABASE_URL to the Neon connection string in Vercel Project Settings.
# Set JWT_SECRET to a long random production-only secret.
# Set BLOB_READ_WRITE_TOKEN when Vercel Blob image storage is enabled.
